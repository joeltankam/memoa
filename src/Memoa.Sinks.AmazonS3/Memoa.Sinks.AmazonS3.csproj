<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(MemoaLibraryTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>Amazon S3 sink for Memoa HTTP request capture middleware.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- AWSSDK.Core transitive dep has low-severity advisory until patched upstream -->
    <NoWarn>$(NoWarn);NU1901;NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="PolySharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Memoa.Core\Memoa.Core.csproj" />
  </ItemGroup>

</Project>
