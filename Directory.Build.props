<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup Label="CI/CD">
    <IsCIBuild Condition="'$(IsCIBuild)' == ''">false</IsCIBuild>
  </PropertyGroup>

  <PropertyGroup Label="Paths">
    <RepositoryRoot>$(MSBuildThisFileDirectory.TrimEnd('\'))</RepositoryRoot>
  </PropertyGroup>

  <PropertyGroup Label="Compilation">
    <TargetFramework Condition="'$(TargetFramework)' == '' AND '$(TargetFrameworks)' == ''">net10.0</TargetFramework>
    <MemoaLibraryTargetFrameworks>net6.0;net8.0;net10.0</MemoaLibraryTargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="Output">
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

  <PropertyGroup Label="Debug information">
    <DebugType Condition="'$(DebugType)' == ''">embedded</DebugType>
    <PathMap Condition="'$(DebugType)' == '' AND '$(IsCIBuild)' == 'true'">$(RepositoryRoot)=sources</PathMap>
  </PropertyGroup>

  <PropertyGroup Label="Tests">
    <IsTestProject>false</IsTestProject>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('Tests'))">true</IsTestProject>
    <RunSettingsFilePath Condition="$(IsTestProject)">$(RepositoryRoot)\build\Config\Tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <PropertyGroup Label="Publishing">
    <IsPublishable Condition="'$(IsPublishable)' == ''">false</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <PackageTags Condition="'$(PackageTags)' == ''">$(MSBuildProjectName.Replace('.', ';'))</PackageTags>
  </PropertyGroup>

  <PropertyGroup Label="Code analysis">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Suppress ConfigureAwait requirement in test projects — NUnit handles synchronization context -->
    <NoWarn Condition="$(IsTestProject)">$(NoWarn);VSTHRD111</NoWarn>
  </PropertyGroup>

  <Import Project="$(RepositoryRoot)/Version.props" />

</Project>
