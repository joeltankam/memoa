<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>

  <packageSources>
    <clear />
    <add key="NuGet.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="NuGet.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
